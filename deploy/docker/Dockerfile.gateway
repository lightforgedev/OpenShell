FROM debian:trixie-slim AS z3-runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends libz3-4 \
    && cp "$(ldconfig -p | awk '/libz3\.so\.4/{print $NF; exit}')" /libz3.so.4 \
    && rm -rf /var/lib/apt/lists/*

