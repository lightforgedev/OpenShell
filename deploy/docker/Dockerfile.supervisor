# The dynamically linked GNU supervisor binary is staged under
# deploy/docker/.build/prebuilt-binaries/<arch>/.

# Keep the GNU C/C++ runtime and CA roots without a shell or unused native TLS libraries.
# The default variant preserves UID 0 and /; compute drivers set the runtime UID.
FROM gcr.io/distroless/cc-debian13@sha256:e1f5543d45a2cd7c02a5b43dda5f0ff30729b4832113759d01ed39b0b152cddb AS supervisor

ARG TARGETARCH

COPY --chmod=0555 deploy/docker/.build/prebuilt-binaries/${TARGETARCH}/openshell-supervisor /openshell-supervisor

# Fail the image build when the staged GNU binary's runtime closure is incomplete.
RUN ["/openshell-supervisor", "--version"]

ENTRYPOINT ["/openshell-supervisor"]
